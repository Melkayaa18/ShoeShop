<Window x:Class="ShoeShop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeShop"
        mc:Ignorable="d"
        Title="Каталог обуви - ОБУВАШКА" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <!-- Строка для шапки с логотипом -->
            <RowDefinition Height="*"/>
            <!-- Строка для списка товаров -->
        </Grid.RowDefinitions>

        <!-- Шапка приложения -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#F0F0F0">
            <!-- Замените logo.png на реальное имя файла вашего логотипа -->
            <Image Source="/Resources/Чудо Обувь.png" Width="50" Height="50" Margin="10,0,15,0"/>
            <TextBlock Text="Каталог обуви" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>
        
        
        <!-- Не забудь в Window добавить пространство имен, если нужно, но для базовых контролов этого достаточно -->
        <ListBox Grid.Row="1" x:Name="ShoeCatalogList" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- Рамка карточки, цвет которой привязан к нашему алгоритму подсветки -->
                    <Border Background="{Binding BackgroundColor}" BorderBrush="LightGray" BorderThickness="1" Margin="5" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <!-- Колонка для картинки -->
                                <ColumnDefinition Width="*"/>
                                <!-- Колонка для характеристик (занимает всё свободное место) -->
                                <ColumnDefinition Width="150"/>
                                <!-- Колонка для цены -->
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- Строка для заголовка -->
                                <RowDefinition Height="*"/>
                                <!-- Строка для контента -->
                            </Grid.RowDefinitions>

                            <!-- Верх: Производство | Наименование (растянуто на все 3 колонки) -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Center" FontWeight="Bold" FontSize="16" Margin="0,0,0,10">
                        <Run Text="{Binding Manufacturer}"/>
                        <Run Text=" | "/>
                        <Run Text="{Binding Title}"/>
                            </TextBlock>

                            <!-- Слева: Картинка -->
                            <Image Grid.Row="1" Grid.Column="0" Source="{Binding DisplayImage}" Width="100" Height="100" Stretch="Uniform"/>

                            <!-- По центру: Категория, количество, состав -->
                            <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="15,0">
                                <TextBlock Text="{Binding Category}" FontSize="14" Margin="0,2"/>
                                <TextBlock Text="{Binding QuantityDisplay}" FontSize="14" Margin="0,2"/>
                                <TextBlock Text="{Binding Composition}" FontSize="14" Margin="0,2" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Справа: Цена со скидкой -->
                            <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="18" FontWeight="Bold" 
           Text="{Binding DiscountedPrice, Mode=OneWay, StringFormat='\{0:N2\} руб.'}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
