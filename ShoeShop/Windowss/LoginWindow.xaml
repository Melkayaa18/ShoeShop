<Window x:Class="ShoeShop.Windowss.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        
        xmlns:local="clr-namespace:ShoeShop.Windowss"
        mc:Ignorable="d"
        Title="Авторизация - ОБУВАШКА" Height="250" Width="350" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock Text="Логин:" FontSize="16" Margin="0,0,0,10"/>
        <TextBox x:Name="LoginTextBox" FontSize="16" Padding="5"/>
        <TextBlock x:Name="ErrorText" Foreground="Red" FontSize="12" Margin="0,5,0,10" Visibility="Collapsed"/>
        <Button Content="Войти" FontSize="16" Padding="10" Margin="0,10,0,0" Click="LoginButton_Click"/>
    </StackPanel>
</Window>
